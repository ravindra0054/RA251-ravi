{
    "name": "magento/project-community-edition",
    "description": "eCommerce Platform for Growth (Community Edition)",
    "type": "project",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "scandipwa/*": true
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false
    },
    "require": {
        "magento/composer-dependency-version-audit-plugin": "^0.1",
        "magento/composer-root-update-plugin": "^2.0",
        "magento/product-community-edition": "2.4.8-p1",
        "mailchimp/mc-magento2": "^103.4",
        "maritos/magento2-performance-fixes": "^1.0",
        "razorpay/magento": "^4.1",
        "scandipwa/catalog-graphql": "^5.3",
        "scandipwa/compare-graphql": "^2.0",
        "scandipwa/contact-graphql": "^2.0",
        "scandipwa/core-scandipwa": "^6.2",
        "scandipwa/customer-graph-ql": "^4.2",
        "scandipwa/framework": "^4.0",
        "scandipwa/graphql-core": "^2.0",
        "scandipwa/installer": "^4.1",
        "scandipwa/persisted-query": "^3.1",
        "scandipwa/quote-graphql": "^3.2",
        "scandipwa/reviews-graphql": "^2.0",
        "scandipwa/route717": "^2.1",
        "scandipwa/slider-graphql": "^3.0",
        "scandipwa/wishlist-graphql": "^2.1",
        "sinergi/browser-detector": "^6.1"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**/*Test"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^3.1",
        "carlos-mg89/oauth": "^0.8.17",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.22",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^5.0",
        "pdepend/pdepend": "^2.16",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^10.5",
        "symfony/finder": "^6.4",
        "magento/magento-allure-phpunit": "^3.0.2"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "theme": {
            "type": "path",
            "url": "localmodules/my-app"
        },
        "0": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "extra": {
        "magento-force": "override"
    }
}